# Gmail AI Manager - Credentials Configuration
# 
# INSTRUCTIONS:
# 1. Copy this file to 'gmail_credentials.env' in the same folder
# 2. Replace the placeholder values with your actual Gmail credentials
# 3. Never commit the actual gmail_credentials.env file to version control

# Your Gmail address
GMAIL_USER=your.email@gmail.com

# Your Gmail App Password (16 characters, generated from Google Account settings)
# DO NOT use your regular Gmail password - this must be an App Password!
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_PASS=your-16-character-app-password

# SECURITY NOTES:
# - Keep this file secure and never share it
# - Use Gmail App Passwords, not your regular password
# - Enable 2-Factor Authentication on your Gmail account first
# - App Passwords bypass 2FA for specific apps like this one